# ============================================================
#  PRODUCTION .env TEMPLATE — e-Learning Practest API
#  Copy to `.env` on the server, fill the <PLACEHOLDERS>, then:
#    php artisan key:generate
#    php artisan migrate --force
#    php artisan db:seed --class=RolesAndPermissionsSeeder --force
#    php artisan db:seed --class=SuperAdminSeeder --force
#    php artisan config:cache && php artisan route:cache && php artisan view:cache
#    php artisan storage:link
#  NEVER commit the filled-in .env. This template holds no secrets.
#  Tailored to launch decisions (2026-07-21): domain practest.live,
#  cPanel SMTP, payments OFF, MSG91 OTP deferred (DLT pending).
# ============================================================

APP_NAME="e-Learning Practest"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.practest.live

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ── Database (MySQL 8 — create in cPanel > MySQL Databases) ───────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=<cpaneluser>_practest
DB_USERNAME=<cpaneluser>_practest
DB_PASSWORD=<STRONG_DB_PASSWORD>

# ── Session / Sanctum (cross-subdomain cookie auth) ──────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.practest.live
SESSION_SECURE_COOKIE=true

SANCTUM_STATEFUL_DOMAINS=app.practest.live
FRONTEND_URL=https://app.practest.live
CORS_ALLOWED_ORIGINS=https://app.practest.live,https://practest.live,https://www.practest.live

# ── Queue / Cache ────────────────────────────────────────────────
# QUEUE_CONNECTION=database is REQUIRED — analytics runs as a queued job.
# A cron must run `php artisan queue:work --stop-when-empty --max-time=55`
# every minute, or students never receive their results.
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# ── Mail (cPanel SMTP mailbox: create noreply@practest.live) ─────
MAIL_MAILER=smtp
MAIL_HOST=mail.practest.live
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_USERNAME=noreply@practest.live
MAIL_PASSWORD=<MAILBOX_PASSWORD>
MAIL_FROM_ADDRESS="noreply@practest.live"
MAIL_FROM_NAME="${APP_NAME}"

# ── Socialite (OPTIONAL — leave blank to keep social login OFF) ──
# If enabled later: set redirect URIs to https://api.practest.live/...
# in the Google/Meta consoles AND flip social_login_enabled in settings.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/api/auth/google/callback"
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI="${APP_URL}/api/auth/facebook/callback"

# ── MSG91 OTP (DEFERRED — DLT template pending) ──────────────────
# Leave blank for launch: phone OTP is non-functional until these are set.
# Consequence: the self-service "request activation (proof upload)" flow is
# gated on phone verification, so launch via ADMIN-ISSUED ACTIVATION CODES
# (code redemption does not require phone verification). Fill these in when
# your DLT template is approved — no code redeploy needed, just this env.
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=PRCTST

# ── Razorpay (payments OFF at launch — leave blank) ──────────────
# The gateway stays disabled via the payment_gateway_enabled setting.
# Fill these + flip the super-admin toggle when you enable online payments.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Google reCAPTCHA v3 (OPTIONAL but recommended) ───────────────
# Blank = middleware skips (register/contact forms work without bot
# protection). Register practest.live AND app.practest.live to enable.
RECAPTCHA_SECRET_KEY=
RECAPTCHA_SITE_KEY=
RECAPTCHA_MIN_SCORE=0.5

VITE_APP_NAME="${APP_NAME}"

# ── Super-Admin (seeded into every deployment) ───────────────────
SUPER_ADMIN_NAME="Thevi Institution"
SUPER_ADMIN_EMAIL=thevinstitution@gmail.com
SUPER_ADMIN_PASSWORD=<STRONG_SUPERADMIN_PASSWORD>
