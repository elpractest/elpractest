# ============================================================
#  PRODUCTION ENV TEMPLATE — e-Learning Practest API
#  Deploy target: COOLIFY (Docker). These values are set as
#  environment variables on the Coolify application, NOT copied
#  into a file on a server. See docs/COOLIFY_DEPLOYMENT.md.
#
#  The api container autoruns migrate + optimize + storage:link
#  at boot (serversideup AUTORUN_*). Seeding is a ONE-OFF after the
#  first deploy, from a Coolify terminal on the api container:
#    php artisan db:seed --force
#  APP_KEY is generated ONCE (`php artisan key:generate --show`) and
#  must stay stable — changing it invalidates sessions + encrypted data.
#  This template holds no secrets.
# ============================================================

APP_NAME="e-Learning Practest"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.practest.live

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Logs go to stderr so they surface in the Coolify container logs.
LOG_CHANNEL=stderr
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ── Database (embedded MariaDB 10.6 compose service) ─────────────
# DB_HOST is the compose service name `mariadb`, resolved on the
# internal Docker network — not 127.0.0.1. DB_DATABASE/USERNAME must
# match the mariadb service's MARIADB_* env in docker-compose.coolify.yml.
DB_CONNECTION=mysql
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=practest
DB_USERNAME=practest
DB_PASSWORD=<STRONG_DB_PASSWORD>
DB_ROOT_PASSWORD=<STRONG_DB_ROOT_PASSWORD>

# ── Session / Sanctum (cross-subdomain cookie auth) ──────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.practest.live
SESSION_SECURE_COOKIE=true

SANCTUM_STATEFUL_DOMAINS=app.practest.live
FRONTEND_URL=https://app.practest.live
CORS_ALLOWED_ORIGINS=https://app.practest.live,https://practest.live,https://www.practest.live

# ── Queue / Cache ────────────────────────────────────────────────
# QUEUE_CONNECTION=database is REQUIRED — analytics runs as a queued job.
# The queue is drained by the dedicated `worker` container (queue:work),
# which is always-on in the compose stack. No cron is involved.
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# ── Mail (transactional provider via env; defaults to log driver) ─
# Leave MAIL_MAILER=log to write mail to the container logs until a real
# provider (SES/Brevo/SMTP) is configured. Set these to send real email.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@practest.live"
MAIL_FROM_NAME="${APP_NAME}"

# ── Socialite (OPTIONAL — leave blank to keep social login OFF) ──
# If enabled later: set redirect URIs to https://api.practest.live/...
# in the Google/Meta consoles AND flip social_login_enabled in settings.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/api/auth/google/callback"
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI="${APP_URL}/api/auth/facebook/callback"

# ── MSG91 OTP (DEFERRED — DLT template pending) ──────────────────
# Leave blank for launch: phone OTP is non-functional until these are set.
# Consequence: the self-service "request activation (proof upload)" flow is
# gated on phone verification, so launch via ADMIN-ISSUED ACTIVATION CODES
# (code redemption does not require phone verification). Fill these in when
# your DLT template is approved — no code redeploy needed, just this env.
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=PRCTST

# ── Razorpay (payments OFF at launch — leave blank) ──────────────
# The gateway stays disabled via the payment_gateway_enabled setting.
# Fill these + flip the super-admin toggle when you enable online payments.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Google reCAPTCHA v3 (OPTIONAL but recommended) ───────────────
# Blank = middleware skips (register/contact forms work without bot
# protection). Register practest.live AND app.practest.live to enable.
# RECAPTCHA_SITE_KEY is also a BUILD ARG for the app image (VITE_RECAPTCHA_SITE_KEY).
RECAPTCHA_SECRET_KEY=
RECAPTCHA_SITE_KEY=
RECAPTCHA_MIN_SCORE=0.5

VITE_APP_NAME="${APP_NAME}"

# ── Super-Admin (seeded once via `php artisan db:seed --force`) ──
SUPER_ADMIN_NAME="Thevi Institution"
SUPER_ADMIN_EMAIL=thevinstitution@gmail.com
SUPER_ADMIN_PASSWORD=<STRONG_SUPERADMIN_PASSWORD>
