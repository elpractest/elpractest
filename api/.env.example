APP_NAME="Practest"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Database ─────────────────────────────────────────────────────
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=practest
# DB_USERNAME=root
# DB_PASSWORD=

# ── Session / Sanctum ────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.practest.live

SANCTUM_STATEFUL_DOMAINS=app.practest.live,localhost:3000,localhost
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── Queue / Cache ────────────────────────────────────────────────
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# ── Study material (the in-app PDF reader) ───────────────────────
# All four have working defaults; set them only to move the files or change
# the ceiling. The disk MUST stay private — these are paid course assets and
# the reader streams them through an entitlement-checked endpoint, never by
# URL. Point it at 's3' where one exists and the stream endpoint switches to
# a short-lived signed URL by itself.
STUDY_MATERIAL_DISK=local
STUDY_MATERIAL_DIRECTORY=study-materials
# Kilobytes. 40 MB covers a scanned 300-page booklet.
STUDY_MATERIAL_MAX_UPLOAD_KB=40960
# Only used when the disk is a cloud driver.
STUDY_MATERIAL_SIGNED_URL_MINUTES=10

# ── Mail ─────────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@practest.live"
MAIL_FROM_NAME="${APP_NAME}"

# ── Socialite: Google ────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/api/auth/google/callback"

# ── Socialite: Facebook ─────────────────────────────────────────
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI="${APP_URL}/api/auth/facebook/callback"

# ── MSG91 OTP ────────────────────────────────────────────────────
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=PRACTEST

# ── Razorpay (behind feature toggle) ────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Google reCAPTCHA v3 ──────────────────────────────────────────
RECAPTCHA_SECRET_KEY=
RECAPTCHA_SITE_KEY=
RECAPTCHA_MIN_SCORE=0.5

VITE_APP_NAME="${APP_NAME}"

# ── OpenAI (Vajini AI study companion) ───────────────────────────
# Set OPENAI_API_KEY on the server only. Without it, Vajini returns 503 and
# nothing else is affected. After setting it, build the corpus once with:
#   php artisan vajini:index
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
VAJINI_TOP_K=5

# ── Super-Admin Setup ────────────────────────────────────────────
# Email + name are the designated owner and must be non-empty: the User model's
# owner-lock guard, the seeder, and the super-admin tests all resolve the
# super-admin by this email, and a blank value here seeds a super-admin with an
# empty email that then fails its own guard. Password stays blank in the
# template — set it in the real .env; the seeder falls back to its own default.
SUPER_ADMIN_NAME="Thevi Institution"
SUPER_ADMIN_EMAIL=thevinstitution@gmail.com
SUPER_ADMIN_PASSWORD=
