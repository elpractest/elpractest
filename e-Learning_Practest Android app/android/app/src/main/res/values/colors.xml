<resources>
    <!--
      White, not the app's own dark. The mark's mortarboard and pencil tip are
      solid black: on a dark plate the icon loses half its silhouette and what
      is left reads as a stray amber hook. White is also what the guide
      specifies, and what every in-app mark tile uses.
    -->
    <color name="ic_launcher_background">#FFFFFF</color>
    <!-- Same in day and night: the app's default theme is dark. -->
    <color name="launch_background">#0B0F1A</color>
</resources>
