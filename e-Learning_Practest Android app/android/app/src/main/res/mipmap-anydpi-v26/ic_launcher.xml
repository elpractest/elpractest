<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon: the mark's mortarboard on the app's own ground.

  The full lockup does not survive the circular mask an OEM may apply, and the
  laptop under the cap turns to mush below about 48 dp. The cap alone is the
  element that stays recognisable at every size, and it sits inside the 72 dp
  safe zone of the 108 dp canvas so no mask can crop into it.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
