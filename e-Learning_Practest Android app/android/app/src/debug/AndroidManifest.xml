<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Debug builds talk to a plain-http Laravel dev server (10.0.2.2:8000 from
         an emulator, or a LAN IP from a real device), so cleartext is allowed
         here only. The release manifest deliberately does NOT allow it —
         production is https://api.practest.live and nothing else. -->
    <application android:usesCleartextTraffic="true">
        <!-- Debug only. Impeller renders correctly on the emulator but its
             surface does not come back through `adb shell screencap` — every
             capture is pure black, which makes screenshot-based verification
             impossible. Skia captures fine. Release keeps Impeller. -->
        <meta-data
            android:name="io.flutter.embedding.android.EnableImpeller"
            android:value="false" />
    </application>
</manifest>
