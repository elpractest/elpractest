---
import '../styles/global.css';
import Analytics from '../components/Analytics.astro';
import ConsentBanner from '../components/ConsentBanner.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'e-Learning Practest — Mock Test Series & LMS for Govt Exams',
  description = 'e-Learning Practest — exam-pattern CBT mock tests for SSC, Banking, Railways, UPSC & State PCS with server-timed sections, deep analytics and structured video courses. A Vinstitution brand.'
} = Astro.props;
const year = new Date().getFullYear();

const spaUrl = import.meta.env.PUBLIC_SPA_URL || 'http://localhost:3000';
const siteUrl = 'https://www.practest.live';
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const orgSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Practest",
  "url": siteUrl,
  "logo": `${siteUrl}/logo.png`,
  "description": description,
  "sameAs": []
});
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="generator" content={Astro.generator} />

    <!-- Theme boot: cookie (shared with the app subdomain) → localStorage → dark -->
    <script is:inline>
      (function () {
        try {
          var m = document.cookie.match(/(?:^|; )practest_theme=(light|dark)/);
          var t = m ? m[1] : localStorage.getItem('practest-theme');
          if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
        } catch (e) { /* default dark stands */ }
      })();
    </script>

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#070b16" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f3f1ea" media="(prefers-color-scheme: light)" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content="/og-image.png" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content="/og-image.png" />

    <!-- Schema.org Organization -->
    <script type="application/ld+json" set:html={orgSchema} />

    <!-- Fonts: Space Grotesk (display) · Inter (UI) · JetBrains Mono (data) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <Analytics />
    <ConsentBanner />
    <div class="layout-wrapper">

      <header class="navbar-header">
        <div class="navbar-container">
          <a href="/" class="brand-logo" aria-label="e-Learning Practest home">
            <span class="logo-tile" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z"/><path d="M22 10v6"/><path d="M6 12.5V16a6 3 0 0 0 12 0v-3.5"/></svg>
            </span>
            <span class="brand-lockup">
              <span class="brand-pre">e-Learning</span>
              <span class="brand-name">Practest<sup class="brand-r">®</sup></span>
            </span>
          </a>

          <nav class="navbar-links" aria-label="Main">
            <a href="/courses">Courses</a>
            <a href="/about">About</a>
            <a href="/contact">Contact</a>
          </nav>

          <div class="navbar-actions">
            <button id="theme-toggle" class="theme-toggle-btn" type="button" aria-label="Switch between day and night mode" title="Day / night mode">
              <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
              <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
            </button>
            <a href={`${spaUrl}/login`} class="btn-secondary nav-login">Login</a>
            <a href={`${spaUrl}/register`} class="btn-primary nav-cta">Start free</a>
          </div>
        </div>
      </header>

      <main class="main-content">
        <slot />
      </main>

      <footer class="footer">
        <div class="footer-container">
          <div class="footer-info">
            <a href="/" class="brand-logo" style="margin-bottom: 14px;">
              <span class="logo-tile" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z"/><path d="M22 10v6"/><path d="M6 12.5V16a6 3 0 0 0 12 0v-3.5"/></svg>
              </span>
              <span class="brand-lockup">
              <span class="brand-pre">e-Learning</span>
              <span class="brand-name">Practest<sup class="brand-r">®</sup></span>
            </span>
            </a>
            <p class="footer-tag">
              Exam-pattern CBT mocks, structured video courses and honest analytics —
              the flagship exam-prep platform of <strong>Vinstitution</strong>.
            </p>
            <div class="omr-strip" aria-hidden="true">
              <i></i><i class="filled"></i><i></i><i class="marker"></i><i></i>
            </div>
          </div>

          <div class="footer-links-group">
            <div class="footer-col">
              <h4>Prepare</h4>
              <a href="/courses">All courses</a>
              <a href={`${spaUrl}/register`}>Create account</a>
              <a href={`${spaUrl}/login`}>Student login</a>
            </div>
            <div class="footer-col">
              <h4>Exams</h4>
              <a href="/courses">SSC CGL</a>
              <a href="/courses">Banking — SBI · IBPS</a>
              <a href="/courses">Railways RRB</a>
              <a href="/courses">UPSC & State PCS</a>
            </div>
            <div class="footer-col">
              <h4>Company</h4>
              <a href="/about">About us</a>
              <a href="/contact">Contact</a>
              <a href="/privacy">Privacy Policy</a>
              <a href="/terms">Terms of Service</a>
              <a href="/refund-policy">Refund Policy</a>
            </div>
            <div class="footer-col footer-office">
              <h4>Registered Office</h4>
              <address>
                Vinstitution, 2nd Floor, Property No. 44,<br />
                Regal Building, Connaught Place,<br />
                New Delhi — 110090
              </address>
              <a href="tel:+919310959596">+91 93109 59596</a>
            </div>
          </div>
        </div>

        <div class="footer-corporate">
          <p class="corp-parent">
            <strong>e-Learning Practest<sup class="brand-r">®</sup></strong> is a brand of the
            <strong>Vinstitution</strong> segment of
            <strong>VPD Vastus Ventures Private Limited</strong>.
          </p>
          <p class="corp-creds">PAN: AAMCV2938B · GSTIN: 07AAMCV2938B1ZA · ISO 9001:2015 Certified</p>
        </div>

        <div class="footer-bottom">
          <p>
            © {year} VPD Vastus Ventures Pvt. Ltd. All rights reserved. ·
            Proudly powered by <strong class="pw">Vinstitution</strong> ·
            Designed by <a href="https://vgraphics.in" target="_blank" rel="noopener">VGraphics.in</a>
          </p>
        </div>
      </footer>
    </div>

    <!-- Floating contact actions (real number: +91 93109 59596) -->
    <div class="fab-stack" aria-label="Quick contact">
      <a
        class="fab fab-wa"
        href="https://wa.me/919310959596?text=Hi%21%20I%27d%20like%20to%20know%20more%20about%20e-Learning%20Practest%20courses."
        target="_blank"
        rel="noopener"
        aria-label="Chat with us on WhatsApp"
      >
        <svg class="fab-ico" viewBox="0 0 32 32" fill="currentColor" aria-hidden="true"><path d="M16.004 0h-.008C7.174 0 .002 7.173.002 16c0 3.5 1.128 6.742 3.046 9.377L1.05 31.02l5.83-1.863A15.9 15.9 0 0 0 16.004 32C24.83 32 32 24.826 32 16S24.83 0 16.004 0zm9.32 22.61c-.386 1.09-1.92 1.995-3.144 2.26-.836.178-1.928.32-5.604-1.204-4.703-1.95-7.73-6.73-7.966-7.04-.226-.31-1.9-2.53-1.9-4.827 0-2.296 1.206-3.425 1.634-3.89.386-.42.842-.51 1.122-.51.28 0 .56.003.804.015.258.013.604-.098.944.72.386.93 1.31 3.226 1.426 3.46.116.234.193.508.038.818-.155.31-.232.503-.464.775l-.696.815c-.232.23-.474.48-.204.94.27.46 1.2 1.98 2.576 3.206 1.77 1.578 3.263 2.066 3.723 2.298.46.232.73.194 1-.117.27-.31 1.15-1.343 1.458-1.804.31-.46.618-.386 1.043-.232.425.155 2.704 1.276 3.167 1.508.464.232.773.348.888.542.116.194.116 1.117-.27 2.206z"/></svg>
        <span class="fab-label">WhatsApp</span>
      </a>
      <a class="fab fab-call" href="tel:+919310959596" aria-label="Call us now at +91 93109 59596">
        <svg class="fab-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        <span class="fab-label">Call now</span>
      </a>
    </div>

    <!-- Theme toggle + scroll reveal (progressive enhancement, ~20 lines) -->
    <script is:inline>
      (function () {
        var btn = document.getElementById('theme-toggle');
        if (btn) btn.addEventListener('click', function () {
          var next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
          document.documentElement.dataset.theme = next;
          try {
            localStorage.setItem('practest-theme', next);
            var host = location.hostname;
            var domain = host.endsWith('practest.live') ? ';domain=.practest.live' : '';
            document.cookie = 'practest_theme=' + next + ';path=/;max-age=31536000;SameSite=Lax' + domain;
          } catch (e) { /* still applied for this page */ }
        });

        if ('IntersectionObserver' in window) {
          var io = new IntersectionObserver(function (entries) {
            entries.forEach(function (en) {
              if (en.isIntersecting) { en.target.classList.add('in-view'); io.unobserve(en.target); }
            });
          }, { threshold: 0.12 });
          document.querySelectorAll('.reveal').forEach(function (el) { io.observe(el); });
        } else {
          document.querySelectorAll('.reveal').forEach(function (el) { el.classList.add('in-view'); });
        }
      })();
    </script>
  </body>
</html>

<style>
  .layout-wrapper {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    width: 100%;
  }

  .navbar-header {
    position: sticky;
    top: 0;
    z-index: 100;
    width: 100%;
    background: var(--panel-bg);
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    border-bottom: 1px solid var(--border-color);
    transition: background-color 0.4s ease;
  }

  .navbar-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 13px 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
  }

  .brand-logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }

  .logo-tile {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 9px;
    background: var(--grad-primary);
    color: #ffffff;
    box-shadow: 0 6px 16px -6px var(--accent-glow);
  }

  .brand-lockup {
    display: inline-flex;
    flex-direction: column;
    gap: 1px;
    line-height: 1.02;
  }

  .brand-pre {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--marker);
  }

  .brand-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.12rem;
    letter-spacing: 0.03em;
    color: var(--text-primary);
  }

  .brand-r {
    font-size: 0.5em;
    font-weight: 600;
    vertical-align: super;
    color: var(--text-secondary);
    margin-left: 1px;
  }

  .navbar-links { display: flex; gap: 28px; }

  .navbar-links a {
    color: var(--text-secondary);
    font-weight: 550;
    font-size: 0.93rem;
    transition: color 0.2s ease;
  }
  .navbar-links a:hover { color: var(--text-primary); }

  .navbar-actions { display: flex; align-items: center; gap: 10px; }

  .theme-toggle-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: 1px solid var(--border-color);
    background: var(--surface-1);
    color: var(--text-primary);
    cursor: pointer;
    transition: transform 0.25s var(--ease-out), border-color 0.2s ease;
  }
  .theme-toggle-btn:hover { transform: translateY(-1px) rotate(12deg); border-color: var(--accent-border); }
  :global([data-theme='dark']) .icon-moon { display: none; }
  :global([data-theme='light']) .icon-sun { display: none; }

  .nav-login { padding: 8px 16px; font-size: 0.85rem; }
  .nav-cta { padding: 8px 18px; font-size: 0.85rem; }

  .main-content { flex-grow: 1; width: 100%; }

  .footer {
    background: var(--bg-soft);
    border-top: 1px solid var(--border-color);
    padding-top: 56px;
    padding-bottom: 28px;
    transition: background-color 0.4s ease;
  }

  .footer-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 40px;
  }

  .footer-tag {
    color: var(--text-secondary);
    font-size: 0.9rem;
    max-width: 320px;
    margin: 0 0 18px 0;
    line-height: 1.6;
  }

  .footer-links-group { display: flex; gap: 44px; flex-wrap: wrap; }

  .footer-col { display: flex; flex-direction: column; gap: 11px; }

  .footer-col h4 {
    margin: 0 0 6px 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--marker);
  }

  .footer-col a {
    color: var(--text-secondary);
    font-size: 0.9rem;
    transition: color 0.2s ease;
  }
  .footer-col a:hover { color: var(--accent-color); }

  .footer-office address {
    font-style: normal;
    color: var(--text-secondary);
    font-size: 0.86rem;
    line-height: 1.65;
  }
  .footer-office a {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--accent-color);
    margin-top: 4px;
  }

  .footer-corporate {
    max-width: 1200px;
    margin: 44px auto 0 auto;
    padding: 22px 24px 0 24px;
    border-top: 1px dashed var(--border-strong);
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 7px;
  }
  .corp-parent {
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.88rem;
    line-height: 1.6;
  }
  .corp-parent strong { color: var(--text-primary); font-weight: 650; }
  .corp-parent .brand-r { font-size: 0.6em; }
  .corp-creds {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    letter-spacing: 0.03em;
    color: var(--marker);
  }

  .footer-bottom {
    max-width: 1200px;
    margin: 18px auto 0 auto;
    padding: 18px 24px 0 24px;
    text-align: center;
    color: var(--text-secondary);
    font-size: 0.82rem;
  }
  .footer-bottom .pw { color: var(--text-primary); font-weight: 650; }
  .footer-bottom a { color: var(--accent-color); font-weight: 600; }

  /* Floating contact FABs */
  .fab-stack {
    position: fixed;
    right: 20px;
    bottom: 20px;
    z-index: 900;
    display: flex;
    flex-direction: column;
    gap: 12px;
    align-items: flex-end;
  }

  .fab {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    height: 54px;
    padding: 0 20px 0 16px;
    border-radius: 999px;
    color: #fff;
    font-weight: 650;
    font-size: 0.92rem;
    white-space: nowrap;
    box-shadow: 0 12px 28px -8px rgba(2, 6, 18, 0.5);
    transition: transform 0.25s var(--ease-out), box-shadow 0.25s ease, filter 0.2s ease;
    animation: fab-in 0.5s var(--ease-out) both;
  }
  .fab:hover { transform: translateY(-3px); filter: brightness(1.05); }
  .fab:active { transform: translateY(0) scale(0.97); }

  .fab-wa { background: #25d366; animation-delay: 0.05s; }
  .fab-wa:hover { box-shadow: 0 16px 34px -8px rgba(37, 211, 102, 0.55); }
  .fab-call { background: var(--grad-primary); animation-delay: 0.12s; }
  .fab-call:hover { box-shadow: 0 16px 34px -8px var(--accent-glow); }

  .fab-ico { width: 26px; height: 26px; flex-shrink: 0; }
  .fab-call .fab-ico { width: 22px; height: 22px; }

  /* gentle attention ring on the WhatsApp button */
  .fab-wa::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    border: 2px solid #25d366;
    animation: fab-ping 2.6s cubic-bezier(0, 0, 0.2, 1) infinite;
    pointer-events: none;
  }
  .fab-wa { position: relative; }

  @keyframes fab-in { from { opacity: 0; transform: translateY(16px) scale(0.9); } to { opacity: 1; transform: none; } }
  @keyframes fab-ping { 0% { opacity: 0.6; transform: scale(1); } 70%, 100% { opacity: 0; transform: scale(1.35); } }

  @media (prefers-reduced-motion: reduce) {
    .fab { animation: none; }
    .fab-wa::before { animation: none; display: none; }
  }

  @media (max-width: 600px) {
    .fab-stack { right: 14px; bottom: 14px; gap: 10px; }
    .fab { height: 50px; width: 50px; padding: 0; justify-content: center; }
    .fab-label { display: none; }
    .fab-ico { width: 24px; height: 24px; }
    .fab-call .fab-ico { width: 21px; height: 21px; }
  }

  @media (max-width: 760px) {
    .navbar-links { display: none; }
    .nav-login { display: none; }
  }
</style>
