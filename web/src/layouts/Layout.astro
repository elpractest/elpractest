---
import '../styles/global.css';
import Analytics from '../components/Analytics.astro';
import ConsentBanner from '../components/ConsentBanner.astro';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = 'Practest - Premium Mock Tests & E-Learning', 
  description = 'Pass your competitive mock test series and video courses with our state-of-the-art CBT exam engine.' 
} = Astro.props;

const spaUrl = import.meta.env.PUBLIC_SPA_URL || 'http://localhost:3000';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/og-image.png" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content="/og-image.png" />
    
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <Analytics />
    <ConsentBanner />
    <div class="layout-wrapper">
      
      <!-- Premium Sticky Glass Navbar -->
      <header class="navbar-header">
        <div class="navbar-container">
          <a href="/" class="brand-logo">
            <span class="logo-icon">⚡</span>
            <span class="brand-name">Practest</span>
          </a>
          
          <nav class="navbar-links">
            <a href="/">Home</a>
            <a href="/courses">Courses</a>
            <a href="/contact">Contact</a>
          </nav>
          
          <div class="navbar-actions">
            <a href={`${spaUrl}/login`} class="btn-primary" style={{ padding: '8px 18px', fontSize: '0.85rem' }}>
              Student Portal
            </a>
          </div>
        </div>
      </header>

      <!-- Content Slot -->
      <main class="main-content">
        <slot />
      </main>

      <!-- Footer -->
      <footer class="footer">
        <div class="footer-container">
          <div class="footer-info">
            <div class="brand-logo" style={{ marginBottom: '16px' }}>
              <span class="logo-icon">⚡</span>
              <span class="brand-name">Practest</span>
            </div>
            <p style={{ color: 'var(--text-secondary)', fontSize: '0.9rem', maxWidth: '300px', margin: 0 }}>
              Leading CBT exam series and structured learning resources engineered for excellence.
            </p>
          </div>
          
          <div class="footer-links-group">
            <div class="footer-col">
              <h4>Platform</h4>
              <a href="/courses">All Courses</a>
              <a href={`${spaUrl}/login`}>Practice Tests</a>
              <a href={`${spaUrl}/register`}>Get Started</a>
            </div>
            
            <div class="footer-col">
              <h4>Support</h4>
              <a href="/contact">Help & Contact</a>
              <a href={`${spaUrl}/login`}>Student Dashboard</a>
            </div>
          </div>
        </div>
        
        <div class="footer-bottom">
          <p>© {new Date().getFullYear()} Practest. All rights reserved. Built for coaching institutes.</p>
        </div>
      </footer>
    </div>
  </body>
</html>

<style>
  .layout-wrapper {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    width: 100%;
  }

  .navbar-header {
    position: sticky;
    top: 0;
    z-index: 100;
    width: 100%;
    background: rgba(11, 15, 25, 0.7);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border-color);
  }

  .navbar-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 16px 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .brand-logo {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 800;
    font-size: 1.25rem;
    color: #ffffff;
  }

  .logo-icon {
    font-size: 1.4rem;
    filter: drop-shadow(0 0 8px var(--accent-color));
  }

  .navbar-links {
    display: flex;
    gap: 32px;
  }

  .navbar-links a {
    color: var(--text-secondary);
    font-weight: 500;
    font-size: 0.95rem;
    transition: color 0.2s ease;
  }

  .navbar-links a:hover {
    color: #ffffff;
  }

  .main-content {
    flex-grow: 1;
    width: 100%;
  }

  /* Footer Styling */
  .footer {
    background: #080b12;
    border-top: 1px solid var(--border-color);
    padding-top: 60px;
    padding-bottom: 30px;
  }

  .footer-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 40px;
  }

  .footer-links-group {
    display: flex;
    gap: 80px;
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .footer-col h4 {
    margin: 0 0 6px 0;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #ffffff;
  }

  .footer-col a {
    color: var(--text-secondary);
    font-size: 0.9rem;
    transition: color 0.2s ease;
  }

  .footer-col a:hover {
    color: var(--accent-color);
  }

  .footer-bottom {
    max-width: 1200px;
    margin: 40px auto 0 auto;
    padding: 24px 24px 0 24px;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    text-align: center;
    color: var(--text-secondary);
    font-size: 0.85rem;
  }
</style>
