---
---
<div id="consent-banner" class="glass-panel consent-banner" style="display: none;">
  <div class="consent-content">
    <span class="consent-icon">🍪</span>
    <p>
      We use cookies to improve your mock exam and learning experience. By clicking "Accept", you agree to our analytics trackers (GA4, Meta Pixel).
    </p>
  </div>
  <div class="consent-actions">
    <button id="consent-decline" class="btn-secondary">Decline</button>
    <button id="consent-accept" class="btn-primary">Accept</button>
  </div>
</div>

<script>
  function getCookie(name) {
    const value = `; ${document.cookie}`;
    const parts = value.split(`; ${name}=`);
    if (parts.length === 2) return parts.pop().split(';').shift();
  }

  function setCookie(name, val, days) {
    const date = new Date();
    date.setTime(date.getTime() + (days * 24 * 60 * 60 * 1000));
    document.cookie = `${name}=${val}; expires=${date.toUTCString()}; path=/; SameSite=Lax; Secure`;
  }

  const banner = document.getElementById('consent-banner');
  const acceptBtn = document.getElementById('consent-accept');
  const declineBtn = document.getElementById('consent-decline');

  // Check existing consent
  const consent = getCookie('practest_consent');

  if (!consent && banner) {
    banner.style.display = 'flex';
  }

  if (acceptBtn && declineBtn && banner) {
    acceptBtn.addEventListener('click', () => {
      setCookie('practest_consent', 'accepted', 365);
      banner.style.display = 'none';
      // Dispatch custom event to notify GTM / Analytics component
      window.dispatchEvent(new Event('practest-consent-granted'));
    });

    declineBtn.addEventListener('click', () => {
      setCookie('practest_consent', 'declined', 365);
      banner.style.display = 'none';
    });
  }
</script>

<style>
  .consent-banner {
    position: fixed;
    bottom: 24px;
    left: 24px;
    right: 24px;
    max-width: 600px;
    margin: 0 auto;
    padding: 20px 24px;
    z-index: 9999;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
    box-shadow: 0 10px 40px rgba(0,0,0,0.5);
  }

  .consent-content {
    display: flex;
    align-items: center;
    gap: 16px;
    flex: 1;
    min-width: 250px;
  }

  .consent-icon {
    font-size: 1.5rem;
  }

  .consent-banner p {
    margin: 0;
    font-size: 0.85rem;
    color: var(--text-primary);
    line-height: 1.5;
  }

  .consent-actions {
    display: flex;
    gap: 12px;
  }

  .consent-actions button {
    padding: 8px 16px;
    font-size: 0.8rem;
    white-space: nowrap;
  }

  @media (max-width: 600px) {
    .consent-banner {
      bottom: 0;
      left: 0;
      right: 0;
      border-radius: 12px 12px 0 0;
      border-left: none;
      border-right: none;
      border-bottom: none;
      padding: 16px;
      gap: 16px;
    }
  }
</style>
