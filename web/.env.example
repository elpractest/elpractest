PUBLIC_API_URL=http://localhost:8000
PUBLIC_SPA_URL=http://localhost:3000
PUBLIC_GTM_ID=
# Same site key as the SPA's VITE_RECAPTCHA_SITE_KEY (api/config/services.php
# `recaptcha.site_key` is the matching server-side secret). Leave blank in any
# environment where RECAPTCHA_SECRET_KEY isn't set on the API — the contact
# form works without it either way, since the server middleware no-ops when
# unconfigured.
PUBLIC_RECAPTCHA_SITE_KEY=
